[
  {
    "id": "claude-code",
    "instructions": ".claude/CLAUDE.md",
    "label": "Claude Code",
    "launch": "claude-code.sh",
    "command": [
      "claude"
    ],
    "resume": [
      "claude",
      "--continue"
    ],
    "memoryMb": 2048,
    "state": {
      "keep": [
        ".claude",
        ".claude.json"
      ],
      "skip": [
        ".claude/shell-snapshots",
        ".claude/statsig"
      ]
    },
    "rights": {
      "full": [
        "--dangerously-skip-permissions",
        "--settings",
        "{\"permissions\":{\"allow\":[\"Bash(parley:*)\"]}}"
      ],
      "ask": [
        "--settings",
        "{\"permissions\":{\"allow\":[\"Bash(parley:*)\"]}}"
      ]
    },
    "install": [
      "node",
      [
        "sudo",
        "-n",
        "npm",
        "install",
        "-g",
        "--no-fund",
        "--no-audit",
        "@anthropic-ai/claude-code"
      ],
      "npm-writable",
      [
        "install",
        "-D",
        "-m",
        "0600",
        "/dev/null",
        ".claude/settings.json"
      ],
      {
        "argv": [
          "tee",
          ".claude/settings.json"
        ],
        "input": "{\n  \"theme\": \"dark-ansi\",\n  \"permissions\": {\n    \"allow\": [\n      \"Bash(parley:*)\"\n    ]\n  }\n}\n"
      }
    ],
    "signin": {
      "senders": [
        "anthropic.com",
        "claude.com",
        "claude.ai"
      ],
      "links": [
        "claude.ai",
        "claude.com",
        "anthropic.com"
      ]
    }
  },
