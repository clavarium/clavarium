[
  {
    "id": "claude-code",
    "label": "Claude Code",
    "command": [
      "claude"
    ],
    "memoryMb": 2048,
    "install": [
      "node",
      [
        "sudo",
        "-n",
        "npm",
        "install",
        "-g",
        "--no-fund",
        "--no-audit",
        "@anthropic-ai/claude-code"
      ],
      "npm-writable",
      {
        "argv": [
          "install",
          "-D",
          "-m",
          "0600",
          "/dev/stdin",
          ".claude/settings.json"
        ],
        "input": "{\n  \"theme\": \"dark-ansi\",\n  \"permissions\": {\n    \"allow\": [\n      \"Bash(parley:*)\"\n    ]\n  }\n}\n"
      }
    ],
    "signin": {
      "senders": [
        "anthropic.com",
        "claude.com",
        "claude.ai"
      ],
      "links": [
        "claude.ai",
        "claude.com",
        "anthropic.com"
      ]
    }
  },
