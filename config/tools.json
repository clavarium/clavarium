  {
    "id": "vibe",
    "instructions": ".vibe/AGENTS.md",
    "label": "Mistral Vibe",
    "launch": "vibe.sh",
    "command": [
      "vibe"
    ],
    "resume": [
      "vibe",
      "--continue"
    ],
    "memoryMb": 2048,
    "state": {
      "keep": [
        ".vibe"
      ]
    },
    "rights": {
      "full": [
        "--auto-approve"
      ]
    },
    "install": [
      [
        "sudo",
        "-n",
        "apt-get",
        "install",
        "-y",
        "-q",
        "--no-install-recommends",
        "python3-venv"
      ],
      [
        "sudo",
        "-n",
        "python3",
        "-m",
        "venv",
        "/opt/vibe"
      ],
      [
        "sudo",
        "-n",
        "/opt/vibe/bin/pip",
        "install",
        "-q",
        "--disable-pip-version-check",
        "mistral-vibe"
      ],
      [
        "sudo",
        "-n",
        "ln",
        "-sf",
        "/opt/vibe/bin/vibe",
        "/usr/local/bin/vibe"
      ]
    ]
  },
