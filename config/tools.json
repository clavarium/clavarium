[
  {
    "id": "claude-code",
    "label": "Claude Code",
    "command": [
      "claude"
    ],
    "memoryMb": 1024,
    "install": [
      "node",
      [
        "sudo",
        "-n",
        "npm",
        "install",
        "-g",
        "--no-fund",
        "--no-audit",
        "@anthropic-ai/claude-code"
      ],
      {
        "argv": [
          "install",
          "-D",
          "-m",
          "0600",
          "/dev/stdin",
          ".claude/settings.json"
        ],
        "input": "{\n  \"theme\": \"dark-ansi\"\n}\n"
      }
    ],
    "signin": {
      "senders": [
        "anthropic.com",
        "claude.com",
        "claude.ai"
      ],
      "links": [
        "claude.ai",
        "claude.com",
        "anthropic.com"
      ]
    }
  },
  {
    "id": "opencode",
    "label": "OpenCode",
    "command": [
      "opencode"
    ],
    "memoryMb": 2048,
    "install": [
      "node",
      [
        "sudo",
        "-n",
        "npm",
        "install",
        "-g",
        "--no-fund",
        "--no-audit",
        "opencode-ai"
      ]
    ]
  },
  {
    "id": "codex",
    "label": "Codex CLI",
    "command": [
      "codex"
    ],
    "memoryMb": 2048,
    "install": [
      "node",
      [
        "sudo",
        "-n",
        "npm",
        "install",
        "-g",
        "--no-fund",
        "--no-audit",
        "@openai/codex"
      ]
    ]
  },
  {
    "id": "gemini",
    "label": "Gemini CLI",
    "command": [
      "gemini"
    ],
    "memoryMb": 2048,
    "install": [
      "node",
      [
        "sudo",
        "-n",
        "npm",
        "install",
        "-g",
        "--no-fund",
        "--no-audit",
        "@google/gemini-cli"
      ]
    ]
  },
  {
    "id": "aider",
    "label": "Aider",
    "command": [
      "aider"
    ],
    "memoryMb": 2048,
    "install": [
      [
        "sudo",
        "-n",
        "env",
        "DEBIAN_FRONTEND=noninteractive",
        "apt-get",
        "update",
        "-q"
      ],
      [
        "sudo",
        "-n",
        "env",
        "DEBIAN_FRONTEND=noninteractive",
        "apt-get",
        "install",
        "-y",
        "-q",
        "--no-install-recommends",
        "pipx",
        "git",
        "ca-certificates"
      ],
      [
        "sudo",
        "-n",
        "env",
        "PIPX_HOME=/opt/pipx",
        "PIPX_BIN_DIR=/usr/local/bin",
        "pipx",
        "install",
        "aider-chat"
      ]
    ]
  },
  {
    "id": "shell",
    "label": "Shell",
    "command": [
      "bash",
      "-l"
    ],
    "memoryMb": 768,
    "install": []
  }
]
