        esac
        # What it goes back to: the connection on that device now, if any.
        prev="$(wifi_active_on "$dev")"; back=""
        [ -z "$prev" ] || back="$(nmcli -e no -g 802-11-wireless.ssid connection show uuid "$prev" 2>/dev/null || true)"
        is_ssid "$back" || back=""
        [ -z "$prev" ] || [ "$back" != "$ssid" ] || refuse "$ssid is the network in use already"
        new=""; read -r new < /proc/sys/kernel/random/uuid || true
        is_uuid "$new" || refuse "no new identifier could be made for the network"
        keys=""; case "$sec" in wpa) keys="wpa-psk" ;; wpa3) keys="sae" ;; esac
        wifi_keyfile "$new" "clavarium-wifi-$(date +%s)" "$dev" "$ssid" "$keys" || refuse "the new network could not be written for NetworkManager"
        password=""
        file="$(wifi_file "$new")"
        if ! nmcli connection load "$file" >/dev/null 2>&1 || [ "$(nmcli -g connection.uuid connection show uuid "$new" 2>/dev/null | head -1 || true)" != "$new" ]; then
            nmcli connection delete uuid "$new" >/dev/null 2>&1 || true; rm -f -- "$file"
            refuse "NetworkManager did not take the new network"
        fi
        install -d -m 0700 "$WIFI_STATE"
        printf 'new %s\nprev %s\ndevice %s\n' "$new" "${prev:-none}" "$dev" > "$WIFI_STATE/switch"
        wifi_record joining
        self=(/bin/bash "$(readlink -f -- "$0")"); [ -z "$TEST" ] || self+=(--test "$TEST")
        if ! systemd-run --quiet --unit="$WIFI_UNIT" --collect --description="Clavarium - Wi-Fi to another network, back to the one before if it does not work" \
            --property=TimeoutStopSec=180 "${self[@]}" wifi switch; then
            nmcli connection delete uuid "$new" >/dev/null 2>&1 || true; rm -f -- "$file"
            rm -f -- "$WIFI_STATE/switch"; wifi_record went-back stopped
            refuse "the switch could not be started (another one still running?)"
        fi
        printf 'joining %s\nfallback %s\n' "$ssid" "$back"
        exit 0 ;;
    "wifi switch")
        # THE SWITCH ITSELF, run by "wifi join" in its unit, as root: asks nothing, it does
        # the switch recorded by the last join (and nothing else: no join, nothing to do).
        # The new connection up; then up to $WIFI_WAIT seconds from its start for a working
        # network (see wifi_online); if there is none, the new network is deleted and the
        # one before brought up again. The outcome is recorded for "wifi status".
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then echo "nmcli connection up <the new network>; ${WIFI_WAIT} s at most for a working network; else nmcli connection delete <the new one>; nmcli connection up <the one before>"; exit 0; fi
        rec="$WIFI_STATE/switch"
        [ -f "$rec" ] && [ "$(wifi_last_word)" = "joining" ] || refuse "no switch was asked"
        new="$(sed -n 's/^new //p' "$rec" | head -1)"; prev="$(sed -n 's/^prev //p' "$rec" | head -1)"; dev="$(sed -n 's/^device //p' "$rec" | head -1)"
        ssid="$(sed -n 's/^lastssid //p' "$WIFI_STATE/last" | head -1)"; back="$(sed -n 's/^lastback //p' "$WIFI_STATE/last" | head -1)"
        is_uuid "$new" && { [ "$prev" = "none" ] || is_uuid "$prev"; } && [[ "$dev" =~ ^[A-Za-z0-9._-]{1,15}$ ]] || refuse "the switch's record is not what it should be"
        rm -f -- "$rec"
        # Back to the connection before: the new one deleted (that ends it) and its file sure
        # to be gone with its password, the old one up, tried three times (the radio may still
        # be busy leaving the other network).
        go_back() {
            local i
            nmcli connection delete uuid "$new" >/dev/null 2>&1 || true
            rm -f -- "$(wifi_file "$new")"
            if [ "$prev" = "none" ]; then wifi_record went-back "$1"; return 0; fi
            for i in 1 2 3; do
                if nmcli --wait "$WIFI_UP_WAIT" connection up uuid "$prev" >/dev/null 2>&1; then wifi_record went-back "$1"; return 0; fi
                sleep "$WIFI_STEP"
            done
            wifi_record back-failed "$1"
        }
        # Stopped in its middle (a shutdown, someone): never left on a network that was not proven.
        trap 'go_back stopped; exit 0' TERM INT HUP
        start="$SECONDS"
        if ! said="$(nmcli --wait "$WIFI_UP_WAIT" connection up uuid "$new" 2>&1 >/dev/null)"; then
            case "$said" in *[Ss]ecrets*|*assword*|*psk*|*802-11-wireless-security*) go_back password ;; *) go_back no-connection ;; esac
            exit 0
        fi
        # (A plain count of looks: $SECONDS is whole seconds, the tests' waits are shorter.)
        looks=$(awk -v w="$WIFI_WAIT" -v s="$WIFI_STEP" 'BEGIN { print int(w / s) }')
        for ((i = 0; i < looks && SECONDS - start < WIFI_WAIT; i++)); do
            if wifi_online "$dev"; then
                nmcli connection modify uuid "$new" connection.autoconnect yes >/dev/null 2>&1 || true
                trap - TERM INT HUP
                wifi_record joined
                exit 0
            fi
            sleep "$WIFI_STEP"
        done
        go_back no-internet
        exit 0 ;;
    "wifi handover")
        # THE NETWORK TO NETWORKMANAGER, asked from Settings: started in a unit of its own ("wifi
        # hand"), and this returns at once: "handing". Refused where it is not possible.
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then
            printf '%s\n' "systemd-run --unit=$HAND_UNIT --collect clavarium-host wifi hand:" \
                "  apt-get install network-manager (when it is not installed)" \
                "  copy $NETPLAN_DIR aside; write $NETPLAN_DIR/$HAND_FILE (root, 0600: renderer NetworkManager); netplan apply" \
                "  ${HAND_WAIT} s at most for the networks in use before to work again: then systemctl disable systemd-networkd-wait-online;" \
                "  else netplan's files put back, netplan apply"
            exit 0
        fi
        ! hand_busy || refuse "the network is being handed over already: wait for its end (a few minutes)"
        ! wifi_busy || refuse "a Wi-Fi switch is going on: wait for its end"
        hand_possible || refuse "this server's network is not one netplan renders with systemd-networkd: nothing to hand over"
        hand_record installing
        self=(/bin/bash "$(readlink -f -- "$0")"); [ -z "$TEST" ] || self+=(--test "$TEST")
        if ! systemd-run --quiet --unit="$HAND_UNIT" --collect --description="Clavarium - the network handed over to NetworkManager, back as it was if it does not work" \
            --property=TimeoutStopSec=180 "${self[@]}" wifi hand; then
            hand_record failed stopped
            refuse "the handover could not be started (another one still running?)"
        fi
        echo "handing"
        exit 0 ;;
    "wifi hand")
        # THE HANDOVER ITSELF, run by "wifi handover" in its unit, as root. NetworkManager
        # installed if it is not (nothing else changed yet: a failure there leaves all as it was);
        # netplan's folder copied aside, root's; one file of netplan's makes NetworkManager the
        # renderer (the Wi-Fi it knew comes with it, and a cable is taken when plugged in); then
        # up to $HAND_WAIT seconds for the networks in use before to work again. If they do not,
        # netplan's files are put back as they were and applied. The outcome is recorded for "wifi status".
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then echo "see: wifi handover"; exit 0; fi
        [ "$(hand_word)" = "installing" ] || refuse "no handover was asked"
        install -d -m 0700 "$HAND_STATE"
        hand_routes > "$HAND_STATE/routes"
        if ! type -P nmcli >/dev/null 2>&1; then
            if ! DEBIAN_FRONTEND=noninteractive apt-get install -y -q network-manager > "$HAND_STATE/install.log" 2>&1; then hand_record failed install; exit 0; fi
        fi
        hand_record switching
        aside="$HAND_STATE/netplan-before"
        rm -rf -- "$aside"; install -d -m 0700 "$aside"
        cp -a -- "$NETPLAN_DIR/." "$aside/" || { hand_record failed copy; exit 0; }
        # Back as it was: netplan's files exactly as copied (theirs only), applied.
        put_back() {
            rm -f -- "$NETPLAN_DIR/$HAND_FILE"
            find "$NETPLAN_DIR" -mindepth 1 -maxdepth 1 -name '*.yaml' -exec rm -f -- {} + 2>/dev/null || true
            cp -a -- "$aside/." "$NETPLAN_DIR/"
            netplan apply >/dev/null 2>&1 || true
            hand_record went-back "$1"
        }
        trap 'put_back stopped; exit 0' TERM INT HUP
        tmp="$(mktemp -p "$NETPLAN_DIR" .clavarium-network.XXXXXX)" || { hand_record failed write; exit 0; }
        chmod 0600 -- "$tmp"
        printf '# Written by Clavarium (Settings, Network): NetworkManager drives the network.\nnetwork:\n  version: 2\n  renderer: NetworkManager\n' > "$tmp"
        [ -n "$TEST" ] || chown root:root -- "$tmp"
        mv -f -- "$tmp" "$NETPLAN_DIR/$HAND_FILE"
        if ! netplan generate >/dev/null 2>&1; then rm -f -- "$NETPLAN_DIR/$HAND_FILE"; trap - TERM INT HUP; hand_record failed invalid; exit 0; fi
        netplan apply >/dev/null 2>&1 || true
        start="$SECONDS"
        looks=$(awk -v w="$HAND_WAIT" -v s="$WIFI_STEP" 'BEGIN { print int(w / s) }')
        for ((i = 0; i < looks && SECONDS - start < HAND_WAIT; i++)); do
            if hand_back_up; then
                trap - TERM INT HUP
                # Its copy held the Wi-Fi password: not kept once it is no longer needed.
                rm -rf -- "$aside"
                # systemd-networkd drives nothing now: its wait for a network would hold each start
                # two minutes, then fail. NetworkManager's own wait takes its place.
                if [ "$(systemctl is-enabled systemd-networkd-wait-online.service 2>/dev/null || true)" = "enabled" ]; then
                    systemctl disable systemd-networkd-wait-online.service >/dev/null 2>&1 && echo "networkd-wait-online disabled" > "$HAND_STATE/undone"
                fi
                hand_record handed
                exit 0
            fi
            sleep "$WIFI_STEP"
        done
        trap - TERM INT HUP
        put_back no-network
        exit 0 ;;
    "wifi forget")
        # <ssid>: every network NetworkManager keeps under that name, deleted. Never the one
        # in use (the server would lose its network), never during a switch.
        [ $# -eq 1 ] || usage
        is_ssid "$1" || refuse "not a network name: 1 to 32 bytes, on one line"
        if [ "$SAY" = "yes" ]; then echo "nmcli connection delete uuid <each saved network named $1>"; exit 0; fi
        type -P nmcli >/dev/null 2>&1 || refuse "NetworkManager (nmcli) is not on this server: its Wi-Fi is managed outside Clavarium"
        ! wifi_busy || refuse "a switch is going on: try again when it has ended"
        active="$(wifi_active_all)"; gone=()
        while IFS= read -r line; do
            u="${line%% *}"
            [ -n "$line" ] && [ "${line#* }" = "$1" ] || continue
            ! grep -qx -- "$u" <<< "$active" || refuse "$1 is the network in use: join another one first"
            gone+=("$u")
        done <<< "$(wifi_saved)"
        [ "${#gone[@]}" -gt 0 ] || refuse "no saved network is named $1"
        for u in "${gone[@]}"; do nmcli connection delete uuid "$u" >/dev/null 2>&1 || refuse "NetworkManager did not forget $1"; done
        printf 'forgotten %s\n' "$1"
        exit 0 ;;
    "path held")
        # <dir>: the check `held` makes, run for real on that path, as the
        # caller (root not needed to refuse). --say-only only: it exists so
        # that the check can be tested without root; it changes nothing.
        [ "$SAY" = "yes" ] || refuse "unknown verb: path held"
        [ $# -eq 1 ] || usage
        held_check "$1"; echo "held: $1"; exit 0 ;;
    "disk room")
        # <has GB> <wants GB> <free MB>: the check `vm set disk` makes, with
        # these figures. --say-only only: it exists so that the check can be
        # tested without a VM manager; it changes nothing.
        [ "$SAY" = "yes" ] || refuse "unknown verb: disk room"
        [ $# -eq 3 ] || usage; number "$1"; number "$2"; [[ "$3" =~ ^[0-9]{1,9}$ ]] || refuse "not a number: $3"
        grow_room "$1" "$2" "$3"; echo "room: $2 GB"; exit 0 ;;
    "git code")
        # <Result> <ExecMainCode> <ExecMainStatus>: the exit code "git read"
        # gives for a unit that ended so. --say-only only: it exists so that
        # the mapping can be tested without root; it does nothing.
        [ "$SAY" = "yes" ] || refuse "unknown verb: git code"
        [ $# -eq 3 ] || usage
        unit_code "$1" "$2" "$3"; exit 0 ;;
    "meshcentral status")
        # THE REMOTE SCREEN, for Settings (Remote screen): installed, running, version, url, and
        # how a turn-on is going. Read-only, nothing asked of the server it runs.
        #   installed <yes|no>   running <yes|no>   version <x.y.z|none>   url <https://.../meshcentral/>
        #   step <installing|starting|running|interrupted|failed>   why <a word>   (only while or after a turn-on)
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then echo "systemctl is-active $MESH_UNIT; the installed version; the route in $CADDYFILE (read-only)"; exit 0; fi
        inst=no; mesh_installed && inst=yes
        up=no; mesh_running && up=yes
        printf 'installed %s\n' "$inst"
        printf 'running %s\n' "$up"
        printf 'version %s\n' "$(mesh_version)"
        printf 'url %s\n' "$(mesh_url)"
        step="$(mesh_step)"
        if [ -n "$step" ]; then
            # A turn-on cut short (a reboot in its middle): no longer going, and it never finished.
            if ! mesh_busy && { [ "$step" = "installing" ] || [ "$step" = "starting" ]; }; then step="interrupted"; fi
            printf 'step %s\n' "$step"
            why="$(sed -n 's/^why \([a-z-]\{1,20\}\)$/\1/p' "$MESH_STATE/last" 2>/dev/null | head -1 || true)"
            [ -z "$why" ] || printf 'why %s\n' "$why"
        fi
        exit 0 ;;
    "meshcentral install")
        # MeshCentral installed into a directory of its own, as a dedicated account: the npm tree
        # at a pinned version, then its config written (kept on a rerun). Idempotent.
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then
            printf '%s\n' "useradd --system $MESH_USER" "install -d $MESH_DATA" \
                "npm install --prefix $MESH_DATA --omit=dev meshcentral@$MESH_VERSION" \
                "write $MESH_DATA/meshcentral-data/config.json"
            exit 0
        fi
        install -d -m 0700 "$MESH_STATE"
        id "$MESH_USER" >/dev/null 2>&1 || useradd --system --home-dir "$MESH_DATA" --no-create-home --shell /usr/sbin/nologin "$MESH_USER"
        install -d -o "$MESH_USER" -g "$MESH_USER" -m 0750 "$MESH_DATA"
        npm="$MESH_NPM"; [ -x "$npm" ] || npm="$(command -v npm || true)"
        [ -n "$npm" ] || refuse "there is no npm on this server to install the remote screen"
        # No secret is printed: npm's own output (and only it) goes to a root-only log.
        # npm finds node through PATH (its own shebang is `/usr/bin/env node`), so node's own
        # directory is put on PATH; without it npm exits at once with "env: node: not found".
        if ! HOME="$MESH_DATA" npm_config_cache="$MESH_DATA/.npm" PATH="$(dirname "$npm"):$(dirname "$MESH_NODE"):$PATH" "$npm" install --prefix "$MESH_DATA" \
                --no-save --no-audit --no-fund --omit=dev "meshcentral@$MESH_VERSION" $MESH_MODULES > "$MESH_STATE/install.log" 2>&1; then
            refuse "MeshCentral could not be installed (see $MESH_STATE/install.log on the server)"
        fi
        [ -f "$MESH_DATA/node_modules/meshcentral/package.json" ] || refuse "MeshCentral was not installed as expected"
        mesh_write_config || refuse "the remote screen's config could not be written"
        chown -R "$MESH_USER:$MESH_USER" "$MESH_DATA"
        printf 'installed %s\n' "$(mesh_version)"
        exit 0 ;;
    "meshcentral start")
        # The hardened unit written and enabled, the server started, and the route added to the
        # front (Caddy reloaded). Idempotent: a rerun rewrites the unit and the route as they are.
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then
            printf '%s\n' "write /etc/systemd/system/$MESH_UNIT.service (hardened: $MESH_USER, NoNewPrivileges, ProtectSystem=strict, ProtectHome, PrivateTmp, its own data dir)" \
                "systemctl enable --now $MESH_UNIT.service" \
                "add 'import $MESH_CADDY' to the site in $CADDYFILE; caddy validate; systemctl reload caddy"
            exit 0
        fi
        mesh_installed || refuse "the remote screen is not installed yet"
        mesh_write_unit || refuse "the remote screen's unit could not be written (no node found?)"
        systemctl enable --quiet "$MESH_UNIT.service" >/dev/null 2>&1 || true
        systemctl restart "$MESH_UNIT.service" || refuse "the remote screen did not start (journalctl -u $MESH_UNIT)"
        mesh_caddy_on || refuse "the route to the remote screen could not be added to the front"
        printf 'started %s\n' "$(mesh_url)"
        exit 0 ;;
    "meshcentral stop")
        # The route removed from the front (Caddy reloaded) and the unit stopped and disabled.
        # What was installed is kept. Idempotent: safe to run when it is off already.
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then
            printf '%s\n' "remove 'import $MESH_CADDY' from $CADDYFILE; rm $MESH_CADDY; systemctl reload caddy" \
                "systemctl disable --now $MESH_UNIT.service"
            exit 0
        fi
        mesh_caddy_off
        systemctl disable --quiet "$MESH_UNIT.service" >/dev/null 2>&1 || true
        systemctl stop "$MESH_UNIT.service" >/dev/null 2>&1 || true
        systemctl reset-failed "$MESH_UNIT.service" >/dev/null 2>&1 || true
        echo "stopped"
        exit 0 ;;
    "meshcentral enable")
        # TURNED ON from Settings: install (minutes, the first time) then start, in a unit of its
        # own, and this returns at once ("enabling"). The outcome is read back by "meshcentral status".
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then echo "systemd-run --unit=$MESH_SETUP_UNIT --collect clavarium-host meshcentral setup (install, then start)"; exit 0; fi
        ! mesh_busy || refuse "the remote screen is being turned on already: wait for its end"
        mesh_record installing
        self=(/bin/bash "$(readlink -f -- "$0")"); [ -z "$TEST" ] || self+=(--test "$TEST")
        if ! systemd-run --quiet --unit="$MESH_SETUP_UNIT" --collect --description="Clavarium - turning on the remote screen (install, then start)" \
                --property=TimeoutStartSec=0 "${self[@]}" meshcentral setup; then
            mesh_record failed start
            refuse "the turn-on could not be started (another one still running?)"
        fi
        echo "enabling"
        exit 0 ;;
    "meshcentral setup")
        # THE TURN-ON ITSELF, run by "meshcentral enable" in its unit, as root: install if it is
        # not installed, then start; each step recorded for "meshcentral status".
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then echo "see: meshcentral enable"; exit 0; fi
        [ "$(mesh_step)" = "installing" ] || refuse "no turn-on was asked"
        self=(/bin/bash "$(readlink -f -- "$0")"); [ -z "$TEST" ] || self+=(--test "$TEST")
        if ! mesh_installed; then
            if ! "${self[@]}" meshcentral install >/dev/null 2>&1; then mesh_record failed install; exit 0; fi
        fi
        mesh_record starting
        if ! "${self[@]}" meshcentral start >/dev/null 2>&1; then mesh_record failed start; exit 0; fi
        mesh_record running
        exit 0 ;;
    "meshcentral disable")
        # TURNED OFF from Settings: stopped and its route removed (what was installed is kept).
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then echo "see: meshcentral stop"; exit 0; fi
        ! mesh_busy || refuse "the remote screen is being turned on: wait for its end"
        self=(/bin/bash "$(readlink -f -- "$0")"); [ -z "$TEST" ] || self+=(--test "$TEST")
        "${self[@]}" meshcentral stop >/dev/null 2>&1 || true
        mesh_record idle
        echo "disabled"
        exit 0 ;;
    "meshcentral uninstall")
        # EVERYTHING REMOVED: stopped, its route and unit gone, its data dir and account removed.
        [ $# -eq 0 ] || usage
        if [ "$SAY" = "yes" ]; then
            printf '%s\n' "systemctl disable --now $MESH_UNIT; rm the unit; remove the route" \
                "rm -rf $MESH_DATA; userdel $MESH_USER"
            exit 0
        fi
        ! mesh_busy || refuse "the remote screen is being turned on: wait for its end"
        mesh_caddy_off
        systemctl disable --quiet "$MESH_UNIT.service" >/dev/null 2>&1 || true
        systemctl stop "$MESH_UNIT.service" >/dev/null 2>&1 || true
        systemctl reset-failed "$MESH_UNIT.service" >/dev/null 2>&1 || true
        rm -f -- "/etc/systemd/system/$MESH_UNIT.service"; systemctl daemon-reload >/dev/null 2>&1 || true
        rm -rf -- "$MESH_DATA"
        ! id "$MESH_USER" >/dev/null 2>&1 || userdel "$MESH_USER" >/dev/null 2>&1 || true
        rm -f -- "$MESH_STATE/last"
        echo "uninstalled"
        exit 0 ;;
    *)
        refuse "unknown verb: $AREA $VERB" ;;
esac
