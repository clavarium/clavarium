#!/bin/bash
# ---------------------------------------------------------------------------
# THE ONLY PRIVILEGED THING THE SERVER MAY DO.
#
# The server runs as an account with no rights. Everything that needs root --
# driving the VM manager, making a read-only view, loading network rules --
# goes through this one program, called with sudo, and the sudoers rule names
# this program and nothing else.
#
# It accepts a FIXED LIST of verbs, in the exact forms the server makes, and
# refuses everything else by name. It is not a general tool and must not
# become one: each verb added here is a thing a compromised server can do.
#
# WHAT IT WILL NOT DO, whatever is asked:
#   - mount anything but a shared folder, a view of one, a work folder or
#     the read-only view of the tools folder into a VM. A mount is served as root: any other path would be a way to
#     read the host's files;
#   - follow a path the server could have bent. A compromised server could
#     replace a folder by a link to /etc and ask for it to be mounted, or
#     swap a directory between our check and the mount. Hence: everything
#     this program mounts, unmounts or moves lives under $MNT (below), on a
#     chain root owns; the entries are made and moved by this program only,
#     and the chain is checked before each use;
#   - touch a VM whose name is not one of ours ("clv-" + a conversation name,
#     or "clvshelf-" + a date for a ready-made machine: see "shelf" below);
#   - load a network rule that is not, line for line, one of the known shapes.
#
# Every name is checked HERE, even though the server checked it already: this
# is where a string becomes a root command.
#
#   --say-only   print the command instead of running it. For tests: a flag,
#                never an environment variable -- in a privileged program, a
#                variable that changes what runs is the hole being closed.
#   --data DIR   the data directory; honoured ONLY with --say-only. Otherwise
#                it is read from /etc/clavarium/host.conf, which root owns.
#   --mnt DIR    where the shared folders live ($MNT, see below); the same
#                rule: --say-only only, else MNT= in host.conf.
#   --test DIR   for the tests of the Wi-Fi verbs, which must run to be tried:
#                run for real, with DIR as the data directory, Wi-Fi's record
#                and NetworkManager's connection files, and waits of seconds instead of a minute. REFUSED AS
#                ROOT: run by a plain account it can do nothing that account
#                could not do already, and under sudo it is never honoured.
#
# WHY THE SHARED FOLDERS ARE NOT IN THE DATA DIRECTORY. The data directory
# belongs to the server's account, so a compromised server could rename any
# of its directories between our check and the moment mount or systemd walks
# the path. So everything that gets mounted, unmounted or moved as root lives
# under $MNT instead -- resources/ (the folders), views/ (their read-only
# views), work/ and work-disks/ (the conversations' work disks), removed/
# (what was put aside), toolbox/ (the tools every machine sees at /tools) -- a chain of directories that root owns from / down:
# no component of it can be swapped by the server (renaming needs write
# access to the parent). `held` checks that chain before each use. The data
# directory keeps only the server's own files, which root never touches.
#
# Exit codes: the command's own; 64 usage; 78 refused, with the reason.
# "git read" has its own fixed codes, listed at that verb.
# ---------------------------------------------------------------------------
set -euo pipefail
# Every command read here speaks the neutral language: numbers with a point, the same words on any
# server (a server in French wrote "1756345,00", and the room set aside on its disk was not seen).
export LC_ALL=C

MULTIPASS="multipass"
IMAGE="24.04"
DISK="8G"
LAUNCH_SECONDS="900"
BRIDGE="mpqemubr0"
TABLE="clavarium"
VM_ID="1000"
# The size of the disk a conversation works in, in megabytes: 10 GB unless
# /etc/clavarium/host.conf says otherwise (WORK_MB=...). Room on the host is
# taken only as the disk is filled, and given back when files are removed.
WORK_MB="10240"
# THE READY-MADE MACHINE ("shelf"): a machine prepared in advance -- system
# updated, shared folders possible, Node.js and the tools installed -- then
# stopped, and COPIED for each new conversation with `multipass clone`
# (Multipass 1.15 and later). A copy boots in a minute or two instead of being
# built for six. It is only ever a source: no conversation runs in it.
SHELF_MEMORY="1536M"
# Where the VM manager keeps its machines' disks: a rebuild is refused when
# less than this is free there, so that a new copy cannot fill the host.
SHELF_STORE="/var/snap/multipass/common"
SHELF_INSTANCES="$SHELF_STORE/data/multipassd/vault/instances"
SHELF_CACHE="$SHELF_STORE/cache"
# Moved to another disk (deploy/move-machines.sh, Multipass's own way: its
# MULTIPASS_STORAGE in a drop-in of its service): <path>/data, <path>/cache.
# (No drop-in is the usual case: under pipefail a missing file must not stop this program.)
MOVED_TO="$( { sed -n 's/^Environment=MULTIPASS_STORAGE=\(\/[A-Za-z0-9/._-]*\)$/\1/p' /etc/systemd/system/snap.multipass.multipassd.service.d/override.conf 2>/dev/null || true; } | head -1)"
if [ -n "$MOVED_TO" ] && [ -d "$MOVED_TO/data" ]; then SHELF_STORE="$MOVED_TO"; SHELF_INSTANCES="$MOVED_TO/data/vault/instances"; SHELF_CACHE="$MOVED_TO/cache"; fi
# Also the floor under a grown disk (grow_room): the server keeps the same
# (MIN_FREE_MB in server/shelf.mjs, used by server/capacity.mjs).
SHELF_MIN_FREE_MB="6144"
CONF="/etc/clavarium/host.conf"
# THE GIT READER (verb "git read"): an empty root-owned directory used as the
# sandbox's root, and the fixed script run inside it. Both made by install.sh.
RUNNER_ROOT="/var/lib/clavarium/runner-root"
GIT_READ="/usr/lib/clavarium/git-read"
LOCKS="/run/clavarium"
# THE UPDATER (verbs "update ..."): the release that runs, its Node.js and its
# updater, all root's (install.sh, deploy/updater.mjs). A request for the
# updater's service is written where only root writes.
CODE="/opt/clavarium"
UPDATER_NODE="$CODE/current/node/bin/node"
UPDATER="$CODE/current/app/deploy/updater.mjs"
UPDATE_STATE="/var/lib/clavarium/update"
# WI-FI (verbs "wifi ..."): root's record of the last switch, read back by
# "wifi status"; the unit a switch runs in; how long a new network has to
# give a working one before the switch goes back, how long one activation may
# take, and how often it is looked at meanwhile (seconds).
WIFI_STATE="/var/lib/clavarium/wifi"
WIFI_UNIT="clavarium-wifi-join"
WIFI_WAIT="60"
WIFI_UP_WAIT="45"
WIFI_STEP="3"
# Where NetworkManager keeps its connections as files (keyfiles): a new network is written
# there by this program, root's and 0600 -- the one place its password is ever written.
NM_KEYFILES="/etc/NetworkManager/system-connections"
# THE NETWORK HANDED OVER TO NETWORKMANAGER (verbs "wifi handover", "wifi hand"): a server set up
# by the Ubuntu installer has its network in netplan, rendered by systemd-networkd, and no
# NetworkManager: its Wi-Fi cannot be chosen from Clavarium, and a cable plugged in later is not
# taken. NetworkManager is installed, one file of netplan's makes it the renderer, and if the
# networks in use before are not working again within $HAND_WAIT seconds, netplan's files are put
# back as they were. Its record; netplan's folder; the file added; the unit it runs in.
HAND_STATE="/var/lib/clavarium/network"
NETPLAN_DIR="/etc/netplan"
HAND_FILE="90-clavarium-network.yaml"
HAND_UNIT="clavarium-network-handover"
HAND_WAIT="90"
# Where the kernel lists the network devices (a physical one has a "device" link there).
SYS_NET="/sys/class/net"
# THE REMOTE SCREEN (verbs "meshcentral ..."): a self-hosted MeshCentral server (Apache-2.0),
# OFF by default, turned on from Settings. It is installed in a directory of its own, owned by
# a dedicated unprivileged account, and run under a hardened unit; it is reached only through
# the existing front (Caddy), under a path -- no second name and no second certificate. The
# turn-on (install, which can take minutes, then start) runs in a unit of its own, and the
# outcome is read back by "meshcentral status".
#   MESH_DATA   the install and its data (the account's; npm tree + meshcentral-data)
#   MESH_STATE  root's record of the turn-on, read back by "meshcentral status"
#   MESH_USER   the dedicated unprivileged account
#   MESH_UNIT / MESH_SETUP_UNIT   the server unit; the unit the turn-on runs in
#   MESH_PORT   the loopback port it listens on (TLS is done by Caddy in front)
#   MESH_PATH   where the front publishes it
#   MESH_VERSION   the version pinned (confirmed on a real host; bump here)
MESH_DATA="/var/lib/clavarium-meshcentral"
MESH_STATE="/var/lib/clavarium/meshcentral"
MESH_USER="clavarium-mesh"
MESH_UNIT="clavarium-meshcentral"
MESH_SETUP_UNIT="clavarium-meshcentral-setup"
MESH_PORT="4443"
# The path's base. The real path adds a per-instance random suffix (mesh_resolve_path), so the
# address is stable here but not the same, nor guessable, from one instance to another.
MESH_PATH_BASE="/meshcentral"
MESH_PATH="$MESH_PATH_BASE"
MESH_VERSION="1.1.35"
# Modules MeshCentral would otherwise fetch from npm on its first run: installed here, with the
# network, because the running unit is locked to the loopback and cannot reach npm. Pinned to
# what MeshCentral 1.1.35 asks for (TOTP two-factor). Revisit if the MeshCentral version moves.
MESH_MODULES="otplib@10.2.3"
# Node and npm: the release's own if it is there (always present on a server), else the system's.
MESH_NODE="/opt/clavarium/current/node/bin/node"
MESH_NPM="/opt/clavarium/current/node/bin/npm"
# The front's config, and the snippet imported into it for the remote screen's route.
CADDYFILE="/etc/caddy/Caddyfile"
MESH_CADDY="/etc/caddy/clavarium-meshcentral.caddy"

refuse() { echo "REFUSED: $*" >&2; exit 78; }
usage() { echo "usage: clavarium-host [--say-only [--data DIR] [--mnt DIR]] <vm|shelf|folder|work|view|tools|mounts|operator|machines|disks|net|git|server|update|wifi|meshcentral> <verb> [arguments]" >&2; exit 64; }

SAY="no"; DATA=""; MNT=""; TEST=""
while [ $# -gt 0 ]; do
    case "$1" in
        --say-only) SAY="yes"; shift ;;
        --data) [ "$SAY" = "yes" ] || refuse "--data is only for --say-only"; DATA="${2:-}"; shift 2 ;;
        --mnt) [ "$SAY" = "yes" ] || refuse "--mnt is only for --say-only"; MNT="${2:-}"; shift 2 ;;
        --test) [ "$(id -u)" != "0" ] || refuse "--test is never for root"; [ "$SAY" = "no" ] || refuse "--test runs for real: not with --say-only"
                TEST="${2:-}"; case "$TEST" in /*) : ;; *) refuse "--test takes an absolute path" ;; esac
                DATA="$TEST"; MNT="$TEST"; WIFI_STATE="$TEST/wifi"; NM_KEYFILES="$TEST/system-connections"; WIFI_WAIT="3"; WIFI_UP_WAIT="3"; WIFI_STEP="0.2"
                HAND_STATE="$TEST/network"; NETPLAN_DIR="$TEST/netplan"; HAND_WAIT="3"; SYS_NET="$TEST/sys-net"
                MESH_DATA="$TEST/mesh"; MESH_STATE="$TEST/meshcentral"; CADDYFILE="$TEST/Caddyfile"; MESH_CADDY="$TEST/clavarium-meshcentral.caddy"; shift 2 ;;
        *) break ;;
    esac
done
if [ -z "$DATA" ]; then
    [ -r "$CONF" ] || refuse "$CONF is missing: the data directory is not declared"
    DATA="$(sed -n 's/^DATA=//p' "$CONF" | head -1)"
fi
if [ -z "$MNT" ]; then
    if [ "$SAY" = "yes" ]; then MNT="$DATA"
    else
        MNT="$(sed -n 's/^MNT=//p' "$CONF" | head -1)"
        [ -n "$MNT" ] || refuse "MNT is not declared in $CONF: run install.sh again"
    fi
fi
if [ -r "$CONF" ]; then
    asked="$(sed -n 's/^WORK_MB=//p' "$CONF" | head -1)"
    if [ -n "$asked" ]; then
        [[ "$asked" =~ ^[0-9]{2,7}$ ]] && [ "$asked" -ge 64 ] || refuse "WORK_MB in $CONF must be a number of megabytes, 64 at least"
        WORK_MB="$asked"
    fi
fi
case "$DATA" in /*) : ;; *) refuse "the data directory must be an absolute path" ;; esac
case "$DATA" in *[!A-Za-z0-9/._-]*|*..*) refuse "the data directory has an unexpected character" ;; esac
# MNT goes into a systemd property list (git read): a space or a colon there
# would split it. The same characters as DATA, nothing else.
case "$MNT" in /*) : ;; *) refuse "MNT must be an absolute path" ;; esac
case "$MNT" in *[!A-Za-z0-9/._-]*|*..*) refuse "MNT has an unexpected character" ;; esac

run() { if [ "$SAY" = "yes" ]; then printf '%s\n' "$*"; else exec "$@"; fi; }

# A conversation or folder name: lower-case letters, digits, hyphens; starts
# with a letter; no trailing hyphen; 32 at most. The same rule as the server.
is_name() { [[ "$1" =~ ^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$ ]]; }
vm_of() { is_name "${1#clv-}" && [ "$1" != "${1#clv-}" ] || refuse "not one of our VMs: ${1:-<empty>}"; }
number() { [[ "$1" =~ ^[0-9]{1,6}$ ]] || refuse "not a number: ${1:-<empty>}"; }
# A disk or partition named by its device: /dev/sdX, /dev/vdX, /dev/nvmeNnN(pN),
# /dev/xvdX, /dev/mmcblkN(pN), with a digit or two at the end; a loop device only
# for the tests (CLAVARIUM_DISKS_LOOP=1, which sudo never passes). It must exist.
disk_dev() {
    local re='^/dev/((sd|vd|xvd|hd)[a-z]{1,2}[0-9]{0,2}|nvme[0-9]{1,2}n[0-9]{1,2}(p[0-9]{1,2})?|mmcblk[0-9]{1,2}(p[0-9]{1,2})?)$'
    [ "${CLAVARIUM_DISKS_LOOP:-}" = "1" ] && re='^/dev/((sd|vd|xvd|hd)[a-z]{1,2}[0-9]{0,2}|nvme[0-9]{1,2}n[0-9]{1,2}(p[0-9]{1,2})?|mmcblk[0-9]{1,2}(p[0-9]{1,2})?|loop[0-9]{1,3}(p[0-9]{1,2})?)$'
    [[ "${1:-}" =~ $re ]] || refuse "not a disk: ${1:-<empty>}"
    [ "$SAY" = "yes" ] || [ -b "$1" ] || refuse "no such disk: $1"
}
# A ready-made machine: "clvshelf-" and the moment it was started, in UTC.
# Never "clv-...": no conversation verb can reach it, and no shelf verb can
# reach a conversation.
shelf_of() { [[ "${1:-}" =~ ^clvshelf-[0-9]{8}-[0-9]{6}$ ]] || refuse "not one of our ready-made machines: ${1:-<empty>}"; }
memory_ok() { number "$1"; [ "$1" -ge 512 ] && [ "$1" -le 65536 ] || refuse "memory out of bounds: $1"; }
# Megabytes free where the VM manager keeps its disks.
store_free() { local at="$SHELF_STORE"; [ -d "$at" ] || at="/var"; df -m --output=avail "$at" | tail -1 | tr -d ' '; }
# The largest disk a conversation's machine may have, in gigabytes: the
# server's own bound (DISK_MAX_GB in server/conversations.mjs).
DISK_MAX_GB="256"
# Whole gigabytes of a size as the VM manager writes it ("8.0GiB", "16G",
# "16384M", bytes), rounded down; nothing when it has another shape.
size_gb() {
    [[ "${1:-}" =~ ^([0-9]{1,12})(\.[0-9]{1,3})?([KMGT]?)(i?B)?$ ]] || return 0
    local n="${BASH_REMATCH[1]}"
    case "${BASH_REMATCH[3]}" in T) echo $((n * 1024)) ;; G) echo "$n" ;; M) echo $((n / 1024)) ;; K) echo $((n / 1048576)) ;; *) echo $((n / 1073741824)) ;; esac
}
# Room to grow a disk from <has> to <wants> gigabytes, with <free> megabytes
# free where the VM manager keeps its disks: what it grows by may all be
# filled, and the same minimum as for a ready-made machine must stay free.
grow_room() {
    local has="$1" wants="$2" free="$3" need
    need=$(( (wants > has ? wants - has : 0) * 1024 + SHELF_MIN_FREE_MB ))
    [ "$free" -ge "$need" ] || refuse "only ${free} MB free for machines; growing this disk from ${has} to ${wants} GB needs ${need} MB"
}

# HELD: the path cannot be bent by anyone but root. Every component from /
# down to the entry's parent is a real directory (not a link), belongs to
# root, and is writable by nobody else; the entry itself is a real directory.
# Then what systemd or mount walks a moment later is the path checked here:
# swapping a component (rename, RENAME_EXCHANGE) needs write access to its
# parent, which only root has. The entry itself may be the server's (a
# folder it fills); what is inside it is the agent's business, not a path.
held() { [ "$SAY" = "yes" ] || held_check "$1"; }
held_check() {
    local path="$1" at="" part
    case "$path" in /*) : ;; *) refuse "not an absolute path: $path" ;; esac
    local parent="${path%/*}"
    IFS='/' read -r -a parts <<< "${parent#/}"
    [ -d / ] && [ "$(stat -c %u /)" = "0" ] || refuse "/ is not root's"
    for part in "${parts[@]}"; do
        [ -n "$part" ] || continue
        at="$at/$part"
        [ -d "$at" ] && [ ! -L "$at" ] || refuse "$at is not a plain directory"
        [ "$(stat -c %u "$at")" = "0" ] || refuse "$at does not belong to root"
        case "$(stat -c %A "$at")" in ?????w????|????????w?) refuse "$at may be written by others than root" ;; esac
        # The mode bits are not the whole story: an access list can give
        # another account write access while they still read 0755. ls marks
        # such a directory with a '+' after the mode.
        acl_free "$at" || refuse "$at has an access list (getfacl): only root may write it"
    done
    [ -d "$path" ] && [ ! -L "$path" ] || refuse "not a plain directory: $path"
}
acl_free() { local mode; mode="$(ls -ld -- "$1" | cut -d' ' -f1)"; [ "${#mode}" -eq 10 ]; }
# One of the directories under $MNT that only root may arrange (resources,
# views, work, work-disks, removed, toolbox): made if missing, refused if it is a link
# or belongs to anyone else -- then its entries cannot be trusted either --
# and HELD (above), with the whole chain above it.
kept() {
    [ "$SAY" = "yes" ] && return 0
    case "$1" in resources|views|work|work-disks|removed|toolbox) : ;; *) refuse "not one of root's directories: $1" ;; esac
    local d="$MNT/$1"
    [ -e "$d" ] || [ -L "$d" ] || install -d -o root -g root -m 0755 "$d"
    [ -d "$d" ] && [ ! -L "$d" ] && [ "$(stat -c %u "$d")" = "0" ] \
        || refuse "$d must be a directory that belongs to root (chown root:root, once, by hand)"
    held "$d"
    # It is itself the parent of what gets mounted or moved: only root may
    # write it, or an entry could be swapped there.
    held "$d/."
}
# A folder of ours: a real directory, directly under resources/, on a held chain.
folder_of() {
    kept resources
    [ "$SAY" = "yes" ] && return 0
    [ -d "$MNT/resources/$1" ] && [ ! -L "$MNT/resources/$1" ] || refuse "no such folder: $1"
    held "$MNT/resources/$1"
}

# A VIEW IN A SERVICE OF ITS OWN (clavarium-view-<name>, transient): bindfs
# runs there, not in the server's service, so that stopping or updating the
# server never cuts a view from under the machines (19-10: a stop killed them
# all, and a view left broken stopped the next start). Asked again at each
# start of the server; a reboot ends them, the server makes them again.
# Arguments: the unit, the folder, the view. Waits until the view is mounted.
view_service() {
    local unit="$1" source="$2" target="$3" i
    if [ "$SAY" = "yes" ]; then printf '%s\n' "systemd-run --unit=$unit --collect bindfs -f -r -o allow_other $source $target"; return 0; fi
    # One left from before (failed, or its mount taken off): out of the way first.
    systemctl stop "$unit.service" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit.service" >/dev/null 2>&1 || true
    systemd-run --quiet --unit="$unit" --collect --description="Clavarium - the read-only view $target" \
        --property=Restart=no bindfs -f -r -o allow_other "$source" "$target" \
        || refuse "the read-only view could not be started: $target"
    for i in $(seq 1 50); do mountpoint -q "$target" && return 0; sleep 0.2; done
    systemctl stop "$unit.service" >/dev/null 2>&1 || true
    refuse "the read-only view did not come up: $target"
}

# A VIEW WHOSE PROGRAM IS GONE (bindfs killed or crashed) stays mounted, but
# everything done there fails with "Transport endpoint is not connected": the
# view cannot be made again, and before 0.2.1 the server died at its start on
# it -- only a reboot cleared it (the update of 19-10). Such a mount is taken
# off (lazily: whatever still holds it gets an error, never a hang); one that
# answers is left alone. Only a FUSE mount exactly at that path, under $MNT.
unstale() {
    [ "$SAY" = "yes" ] && return 0
    local at="$1"
    case "$at" in "$MNT"/views/*|"$MNT"/toolbox/view) : ;; *) refuse "not a view: $at" ;; esac
    awk -v p="$at" '$2 == p && $3 ~ /^fuse/ { found = 1 } END { exit !found }' /proc/self/mounts || return 0
    timeout 10 stat -- "$at" >/dev/null 2>&1 && return 0
    umount -l -- "$at" || refuse "the broken view at $at could not be taken off"
    echo "a broken view was taken off: $at" >&2
}

# How a finished read unit is said to the server: from what systemd recorded,
# never from what the code inside printed. See "git read".
unit_code() {
    local result="$1" how="$2" status="$3"
    case "$result" in
        timeout) echo 80 ;;
        oom-kill) echo 81 ;;
        signal|core-dump) echo 82 ;;
        exit-code)
            # 1: the process exited (2 killed, 3 dumped: told by Result above).
            if [ "$how" != "1" ] || ! [[ "$status" =~ ^[0-9]{1,3}$ ]]; then echo 79
            elif [ "$status" = "128" ]; then echo 65
            elif [ "$status" = "3" ]; then echo 67
            # 200-243: systemd could not start the process. The wrapper turns
            # every other code of git into 66, so these are systemd's own.
            elif [ "$status" -ge 200 ] && [ "$status" -le 243 ]; then echo 79
            else echo 66
            fi ;;
        *) echo 79 ;;
    esac
}

# WI-FI: the networks THIS SERVER sees, through NetworkManager (nmcli). The
# server is often reached from afar over that very Wi-Fi, so a switch that
# does not work must never leave it cut off: a switch runs as root in a unit
# of its own (it outlives the page, the request and the server's own network
# going away), and goes back to the connection it left when the new one gives
# no working network within $WIFI_WAIT seconds. The new network is saved with
# autoconnect off until it has worked: a reboot in the middle comes back on
# the old one. A password comes on standard input only (an argument shows in
# ps to everyone) and goes to nmcli only; it is never printed, never recorded.
#
# nmcli under LC_ALL=C writes a '?' for every character outside ASCII ("Café" came
# out "Caf?", and could then not be joined: found on a real NetworkManager). Its
# words stay English and its format the same under C.UTF-8; the names stay whole.
nmcli() { LC_ALL=C.UTF-8 command nmcli "$@"; }
# One line of `nmcli -t` cut into FIELDS: ':' separates, and '\' makes the
# next character plain (nmcli writes a ':' or a '\' inside a value as '\:'
# and '\\': an SSID may hold either).
terse_fields() {
    local line="$1" field="" c i
    FIELDS=()
    for ((i = 0; i < ${#line}; i++)); do
        c="${line:i:1}"
        if [ "$c" = '\' ] && [ $((i + 1)) -lt ${#line} ]; then i=$((i + 1)); field+="${line:i:1}"
        elif [ "$c" = ':' ]; then FIELDS+=("$field"); field=""
        else field+="$c"; fi
    done
    FIELDS+=("$field")
}
# A network's name as this program takes it: 1 to 32 bytes (LC_ALL=C: ${#} counts
# bytes, so a name in any script is measured as the radio does), no control
# character (it is one line everywhere it goes).
is_ssid() { [ "${#1}" -ge 1 ] && [ "${#1}" -le 32 ] && [[ "$1" != *[[:cntrl:]]* ]]; }
is_uuid() { [[ "${1:-}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; }
# What nmcli says of a network's protection, in one word: open, wpa (a password,
# WPA2 or older, or WPA3 alongside), wpa3 (WPA3 only), and what cannot be joined
# with a password alone here: wep, enterprise (a user and a certificate), other.
security_of() {
    case "$1" in
        ""|"--") echo open ;;
        *802.1X*) echo enterprise ;;
        *WEP*) echo wep ;;
        *WPA1*|*WPA2*) echo wpa ;;
        *WPA3*) echo wpa3 ;;
        *WPA*) echo wpa ;;
        *) echo other ;;
    esac
}
# The Wi-Fi device NetworkManager has, and its state: "<device> <state>", or nothing.
wifi_device() {
    local out line
    out="$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null || true)"
    while IFS= read -r line; do
        terse_fields "$line"
        [ "${FIELDS[1]:-}" = "wifi" ] && [[ "${FIELDS[0]}" =~ ^[A-Za-z0-9._-]{1,15}$ ]] || continue
        printf '%s %s\n' "${FIELDS[0]}" "${FIELDS[2]:-unknown}"; return 0
    done <<< "$out"
    return 0
}
# The networks in sight on <device>, one per name (its strongest): "<signal> <security> <now|other> <ssid>",
# the strongest first. <rescan>: yes (a fresh look, a few seconds) or no (what NetworkManager saw last).
wifi_seen() {
    local out line ssid signal sec now
    declare -A best=() how=() inuse=()
    out="$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list ifname "$1" --rescan "$2" 2>/dev/null)" \
        || out="$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list ifname "$1" --rescan no 2>/dev/null)" \
        || return 1
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        terse_fields "$line"
        [ "${#FIELDS[@]}" -eq 4 ] || continue
        now="${FIELDS[0]}"; ssid="${FIELDS[1]}"; signal="${FIELDS[2]}"; sec="$(security_of "${FIELDS[3]}")"
        # A hidden network has no name to show (nmcli writes it empty, or "--").
        [ "$ssid" != "--" ] && is_ssid "$ssid" && [[ "$signal" =~ ^[0-9]{1,3}$ ]] && [ "$signal" -le 100 ] || continue
        [ "$now" = "*" ] && inuse["$ssid"]=1
        if [ -z "${best["$ssid"]:-}" ] || [ "$signal" -gt "${best["$ssid"]}" ]; then best["$ssid"]="$signal"; how["$ssid"]="$sec"; fi
    done <<< "$out"
    for ssid in "${!best[@]}"; do
        if [ -n "${inuse["$ssid"]:-}" ]; then now="now"; else now="other"; fi
        printf '%s %s %s %s\n' "${best["$ssid"]}" "${how["$ssid"]}" "$now" "$ssid"
    done | sort -k1,1nr -k4
}
# The Wi-Fi networks NetworkManager keeps: "<uuid> <ssid>", one per profile.
wifi_saved() {
    local out line u s
    out="$(nmcli -t -f UUID,TYPE connection show 2>/dev/null || true)"
    while IFS= read -r line; do
        terse_fields "$line"
        u="${FIELDS[0]:-}"
        case "${FIELDS[1]:-}" in 802-11-wireless|wifi) : ;; *) continue ;; esac
        is_uuid "$u" || continue
        # One value, asked unescaped: it is the whole of what is printed. (Its input is not
        # the loop's: nothing it reads may eat the lines still to come.)
        s="$(nmcli -e no -g 802-11-wireless.ssid connection show uuid "$u" 2>/dev/null < /dev/null || true)"
        is_ssid "$s" && printf '%s %s\n' "$u" "$s"
    done <<< "$out"
    return 0
}
# The uuid of the connection active on <device> (nothing when none), and every active one.
wifi_active_on() {
    local out line
    out="$(nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null || true)"
    while IFS= read -r line; do
        terse_fields "$line"
        [ "${FIELDS[1]:-}" = "$1" ] && is_uuid "${FIELDS[0]}" && { echo "${FIELDS[0]}"; return 0; }
    done <<< "$out"
    return 0
}
wifi_active_all() { nmcli -t -f UUID connection show --active 2>/dev/null | grep -E '^[0-9a-f-]{36}$' || true; }
# A working network through <device>: NetworkManager's own check says "full".
# When it does not check here (no check configured: "unknown"), the gateway of
# the Wi-Fi device answering will do.
wifi_online() {
    local c gw
    c="$(nmcli networking connectivity check 2>/dev/null || true)"
    case "$c" in full) return 0 ;; limited|portal|none) return 1 ;; esac
    gw="$(nmcli -g IP4.GATEWAY device show "$1" 2>/dev/null | head -1 || true)"
    [[ "$gw" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    ping -c 1 -W 2 -I "$1" "$gw" >/dev/null 2>&1
}
# The last switch, as recorded: its first word (joining, joined, went-back...), or nothing.
wifi_last_word() { sed -n 's/^last \([a-z-]*\) [0-9]*$/\1/p' "$WIFI_STATE/last" 2>/dev/null | head -1 || true; }
# A switch is going on: recorded as such, and recently (a reboot in its middle
# leaves "joining" behind; it is not believed for ever).
wifi_busy() {
    local at
    [ "$(wifi_last_word)" = "joining" ] || return 1
    at="$(sed -n 's/^last joining \([0-9]*\)$/\1/p' "$WIFI_STATE/last" | head -1)"
    [ $(( $(date +%s) - ${at:-0} )) -lt $((WIFI_WAIT * 10)) ]
}
# A NEW NETWORK AS A NETWORKMANAGER KEYFILE, the format it keeps its own connections in:
# <uuid> <name> <device> <ssid> <key-mgmt, or nothing for an open network>; the password
# is $password. Its file is named from the uuid, never from the SSID (which may hold any
# byte); the SSID is written as its list of bytes ("104;111;109;101;"), unambiguous for
# any of them. Written whole beside it, root's, 0600, then renamed into place: NetworkManager
# never reads half a file (and skips a name that starts with a dot). The password goes from
# printf, part of bash, into that file: no program is started with it among its arguments.
wifi_file() { printf '%s/clavarium-wifi-%s.nmconnection' "$NM_KEYFILES" "$1"; }
wifi_keyfile() {
    local file tmp bytes="" b
    file="$(wifi_file "$1")"
    for b in $(printf '%s' "$4" | od -An -v -tu1); do bytes+="$b;"; done
    [ -d "$NM_KEYFILES" ] || install -d -m 0700 "$NM_KEYFILES"
    tmp="$(mktemp -p "$NM_KEYFILES" .clavarium-wifi.XXXXXX)" || return 1
    chmod 0600 -- "$tmp"
    # In a keyfile value a '\' starts an escape: written doubled.
    if ! { printf '[connection]\nid=%s\nuuid=%s\ntype=wifi\ninterface-name=%s\nautoconnect=false\n\n' "$2" "$1" "$3"
           printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$bytes"
           [ -z "$5" ] || printf '[wifi-security]\nkey-mgmt=%s\npsk=%s\n\n' "$5" "${password//\\/\\\\}"
           printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'; } > "$tmp"; then rm -f -- "$tmp"; return 1; fi
    [ -n "$TEST" ] || chown root:root -- "$tmp"
    mv -f -- "$tmp" "$file"
}
# THE HANDOVER. Possible where netplan renders the network with systemd-networkd (its default)
# and this program has not handed it over already; apt-get to install NetworkManager.
hand_possible() {
    local r
    type -P netplan >/dev/null 2>&1 && type -P apt-get >/dev/null 2>&1 || return 1
    [ ! -e "$NETPLAN_DIR/$HAND_FILE" ] || return 1
    compgen -G "$NETPLAN_DIR/*.yaml" >/dev/null || return 1
    r="$(netplan get renderer 2>/dev/null | head -1 || true)"
    case "$r" in ""|null|networkd) return 0 ;; *) return 1 ;; esac
}
# Its record: "hand <state> <seconds since 1970>" and "handwhy <why>".
hand_record() {
    install -d -m 0700 "$HAND_STATE"
    { printf 'hand %s %s\n' "$1" "$(date +%s)"; [ -z "${2:-}" ] || printf 'handwhy %s\n' "$2"; } > "$HAND_STATE/last.new"
    mv -f -- "$HAND_STATE/last.new" "$HAND_STATE/last"
}
hand_word() { sed -n 's/^hand \([a-z-]*\) [0-9]*$/\1/p' "$HAND_STATE/last" 2>/dev/null | head -1 || true; }
# Going on: recorded as such, and not for longer than an install and a wait could take.
hand_busy() {
    local at
    case "$(hand_word)" in installing|switching) : ;; *) return 1 ;; esac
    at="$(sed -n 's/^hand [a-z]* \([0-9]*\)$/\1/p' "$HAND_STATE/last" | head -1)"
    [ $(( $(date +%s) - ${at:-0} )) -lt 1800 ]
}
# The networks in use: "<device> <gateway>", one per default route.
hand_routes() { ip -4 route show default 2>/dev/null | sed -n 's/^default via \([0-9.]*\) dev \([A-Za-z0-9._-]*\).*$/\2 \1/p' | sort -u || true; }
# Each of them working again, through NetworkManager: connected, with its way out (a default
# route through it). Not its gateway answering a ping: many a box does not answer one.
hand_back_up() {
    local dev gw st
    while read -r dev gw; do
        [ -n "$dev" ] || continue
        st="$(nmcli -g GENERAL.STATE device show "$dev" 2>/dev/null | head -1 || true)"
        case "$st" in 100*) : ;; *) return 1 ;; esac
        [ -n "$(ip -4 route show default dev "$dev" 2>/dev/null || true)" ] || return 1
    done < "$HAND_STATE/routes"
    [ "$(nmcli -t -f RUNNING general 2>/dev/null || true)" = "running" ]
}

# The outcome of a switch, recorded for "wifi status": <state> [<why>]. Uses $ssid and $back.
wifi_record() {
    install -d -m 0700 "$WIFI_STATE"
    { printf 'last %s %s\n' "$1" "$(date +%s)"; printf 'lastssid %s\n' "$ssid"; printf 'lastback %s\n' "$back"
      [ -z "${2:-}" ] || printf 'lastwhy %s\n' "$2"; } > "$WIFI_STATE/last.new"
    mv -f -- "$WIFI_STATE/last.new" "$WIFI_STATE/last"
}

# ---- THE REMOTE SCREEN (MeshCentral) ----
# Installed: the npm tree and a written config are both there. Running: its unit is active.
mesh_installed() { [ -f "$MESH_DATA/node_modules/meshcentral/package.json" ] && [ -f "$MESH_DATA/meshcentral-data/config.json" ]; }
# The path's per-instance random suffix: made once, kept in root's state, reused ever after -- so the
# address is stable for this server yet not guessable, and differs from one install to the next.
# Defence in depth, on top of the sign-in and the isolation. In --test a fixed suffix keeps it checkable.
mesh_resolve_path() {
    if [ -n "$TEST" ]; then MESH_PATH="$MESH_PATH_BASE-test"; return 0; fi
    local f="$MESH_STATE/path" tok=""
    # No "| head" on an endless source: head closing early makes the left side take SIGPIPE, which
    # under pipefail would stop the whole program. od reads a fixed count, so nothing closes early.
    if [ -f "$f" ]; then tok="$(LC_ALL=C tr -cd 'a-z0-9' < "$f" 2>/dev/null)"; tok="${tok:0:16}"; fi
    if ! [[ "$tok" =~ ^[a-z0-9]{8,16}$ ]]; then
        tok="$(od -An -tx1 -N16 /dev/urandom 2>/dev/null | LC_ALL=C tr -cd '0-9a-f')"; tok="${tok:0:12}"
        [[ "$tok" =~ ^[a-z0-9]{8,16}$ ]] || tok="$(date +%s)0"
        # Keep it only on a real run; "say only" invents nothing on disk.
        if [ "$SAY" != yes ]; then
            install -d -m 0700 "$MESH_STATE" 2>/dev/null || true
            { printf '%s' "$tok" > "$f"; } 2>/dev/null && chmod 0600 "$f" 2>/dev/null || true
        fi
    fi
    MESH_PATH="$MESH_PATH_BASE-$tok"
}
mesh_running() { [ -z "$TEST" ] && systemctl is-active --quiet "$MESH_UNIT.service" 2>/dev/null; }
# The version as the installed package declares it, or nothing.
mesh_version() {
    local v
    v="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([0-9][0-9A-Za-z.+-]*\)".*/\1/p' "$MESH_DATA/node_modules/meshcentral/package.json" 2>/dev/null | head -1 || true)"
    [[ "$v" =~ ^[0-9][0-9A-Za-z.+-]{0,30}$ ]] && printf '%s' "$v" || printf 'none'
}
# Where the front publishes it: the front's own name, this path. Just the path when no name is set yet.
mesh_url() {
    local dom
    dom="$(sed -n 's/^\([A-Za-z0-9][A-Za-z0-9.*-]*\) {[[:space:]]*$/\1/p' "$CADDYFILE" 2>/dev/null | grep -v '^http' | head -1 || true)"
    if [[ "$dom" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]]; then printf 'https://%s%s/' "$dom" "$MESH_PATH"; else printf '%s/' "$MESH_PATH"; fi
}
# The turn-on's step, read back by "meshcentral status": <step> [<why>].
mesh_record() {
    install -d -m 0700 "$MESH_STATE"
    { printf 'step %s %s\n' "$1" "$(date +%s)"; [ -z "${2:-}" ] || printf 'why %s\n' "$2"; } > "$MESH_STATE/last.new"
    mv -f -- "$MESH_STATE/last.new" "$MESH_STATE/last"
}
mesh_step() { sed -n 's/^step \([a-z-]*\) [0-9]*$/\1/p' "$MESH_STATE/last" 2>/dev/null | head -1 || true; }
mesh_busy() { [ -z "$TEST" ] && systemctl is-active --quiet "$MESH_SETUP_UNIT.service" 2>/dev/null; }

# The route into the front: a snippet of its own, imported once into the site block. Reused on
# a rerun, never doubled; removed whole when the screen is turned off (an import with no file
# would stop the front, so the line and the file always go together).
mesh_caddy_reload() {
    [ -z "$TEST" ] || return 0
    /usr/local/bin/caddy validate --config "$CADDYFILE" >/dev/null 2>&1 || return 1
    systemctl reload caddy.service >/dev/null 2>&1 || systemctl restart caddy.service >/dev/null 2>&1 || true
}
mesh_caddy_on() {
    [ -f "$CADDYFILE" ] || return 1
    local tmp; tmp="$(mktemp -p "$(dirname "$MESH_CADDY")" .clavarium-mesh.XXXXXX)" || return 1
    { printf '# Written by Clavarium (Settings, Remote screen). Removed when it is turned off.\n'
      printf 'handle %s* {\n\treverse_proxy 127.0.0.1:%s\n}\n' "$MESH_PATH" "$MESH_PORT"; } > "$tmp"
    [ -n "$TEST" ] || chown root:root -- "$tmp"; chmod 0644 -- "$tmp"; mv -f -- "$tmp" "$MESH_CADDY"
    if ! grep -q '# clavarium-meshcentral$' "$CADDYFILE"; then
        local out; out="$(mktemp -p "$(dirname "$CADDYFILE")" .clavarium-caddy.XXXXXX)" || return 1
        awk 'BEGIN { done = 0 } { print }
             done == 0 && $0 !~ /^http/ && /^[A-Za-z0-9].*\{[[:space:]]*$/ { print "\timport " FULL " # clavarium-meshcentral"; done = 1 }' \
            FULL="$MESH_CADDY" "$CADDYFILE" > "$out" || { rm -f -- "$out"; return 1; }
        cat -- "$out" > "$CADDYFILE"; rm -f -- "$out"
    fi
    mesh_caddy_reload || { mesh_caddy_off; return 1; }
}
mesh_caddy_off() {
    rm -f -- "$MESH_CADDY"
    if [ -f "$CADDYFILE" ] && grep -q '# clavarium-meshcentral$' "$CADDYFILE"; then
        local out; out="$(mktemp -p "$(dirname "$CADDYFILE")" .clavarium-caddy.XXXXXX)" || return 1
        grep -v '# clavarium-meshcentral$' "$CADDYFILE" > "$out" || true
        cat -- "$out" > "$CADDYFILE"; rm -f -- "$out"
    fi
    mesh_caddy_reload || true
}

# The config the server is given: TLS is the front's, so it listens plain on the loopback; it
# makes no certificate of its own and asks Let's Encrypt for none. Written once, kept on a rerun.
mesh_write_config() {
    install -d -m 0750 "$MESH_DATA/meshcentral-data"
    [ -n "$TEST" ] || chown -R "$MESH_USER:$MESH_USER" "$MESH_DATA/meshcentral-data"
    [ ! -f "$MESH_DATA/meshcentral-data/config.json" ] || return 0
    # MeshCentral serves under a path through a NAMED domain (its key is the path): a domain keyed
    # "meshcentral" is reached at /meshcentral/. The empty key would serve at the root, which the
    # front has no path for. Derived from MESH_PATH so the two never drift apart.
    local dom="${MESH_PATH#/}"
    local tmp; tmp="$(mktemp -p "$MESH_DATA/meshcentral-data" .clavarium-mesh.XXXXXX)" || return 1
    cat > "$tmp" <<MESHCONF
{
  "__comment": "Written by Clavarium (Settings, Remote screen). TLS and the public name are the front's.",
  "settings": {
    "cert": "localhost",
    "TLSOffload": true,
    "WANproxy": true,
    "Port": $MESH_PORT,
    "RedirPort": 0,
    "ExactPorts": true,
    "AllowFraming": false,
    "SelfUpdate": false
  },
  "domains": {
    "$dom": {
      "certUrl": "https://127.0.0.1:$MESH_PORT/"
    }
  },
  "letsencrypt": null
}
MESHCONF
    chmod 0640 -- "$tmp"; [ -n "$TEST" ] || chown "$MESH_USER:$MESH_USER" -- "$tmp"
    mv -f -- "$tmp" "$MESH_DATA/meshcentral-data/config.json"
}

# The hardened unit: a dedicated account, nothing of the system writable but its own data dir,
# no new privileges, no home, a private /tmp. Written every turn-on (kept in step with this file).
mesh_write_unit() {
    [ -z "$TEST" ] || return 0
    local node; node="$MESH_NODE"; [ -x "$node" ] || node="$(command -v node || true)"
    [ -n "$node" ] || return 1
    cat > "/etc/systemd/system/$MESH_UNIT.service" <<MESHUNIT
[Unit]
Description=Clavarium - the remote screen (MeshCentral), isolated behind the front
After=network-online.target caddy.service
Wants=network-online.target

[Service]
User=$MESH_USER
Group=$MESH_USER
WorkingDirectory=$MESH_DATA
# node's directory on PATH: MeshCentral installs a module or two on first run by spawning npm,
# whose shebang is \`/usr/bin/env node\`; without this it stalls at "Installing modules".
Environment=PATH=$(dirname "$node"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=$node $MESH_DATA/node_modules/meshcentral --datapath $MESH_DATA/meshcentral-data
Restart=on-failure
RestartSec=5
# Isolation: the whole system read-only but its own data, no new privileges, no home, a private /tmp.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# AF_NETLINK too: Node reads the host's network interfaces (os.networkInterfaces) through it, and
# MeshCentral lists them at startup; without it the server dies with "uv_interface_addresses ... 97".
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=$MESH_DATA
# Reached only on the loopback (the front is in front): no low port, no raw network.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
MESHUNIT
    systemctl daemon-reload
}

[ $# -ge 2 ] || usage
AREA="$1"; VERB="$2"; shift 2

# The remote screen's path carries a per-instance suffix: resolve it before any of its verbs run.
[ "$AREA" = meshcentral ] && mesh_resolve_path

case "$AREA $VERB" in
    "vm launch")
        [ $# -eq 2 ] || usage; vm_of "$1"; memory_ok "$2"
        run "$MULTIPASS" launch "$IMAGE" --name "$1" --memory "${2}M" --disk "$DISK" --cpus 1 --timeout "$LAUNCH_SECONDS" ;;
    "vm clone")
        # <shelf> <vm> <memory>: a conversation's machine, copied from the
        # ready-made one (which must be stopped: Multipass refuses otherwise).
        # A copy has the size of its source; its memory is set before its
        # first start, while it is still stopped.
        [ $# -eq 3 ] || usage; shelf_of "$1"; vm_of "$2"; memory_ok "$3"
        if [ "$SAY" = "yes" ]; then
            printf '%s\n' "$MULTIPASS clone $1 --name $2" "$MULTIPASS set local.$2.memory=${3}M"; exit 0
        fi
        "$MULTIPASS" clone "$1" --name "$2"
        exec "$MULTIPASS" set "local.$2.memory=${3}M" ;;
    "vm exec")
        [ $# -ge 1 ] || usage; vm_of "$1"; [ "${2:-}" = "--" ] || refuse "exec takes: <vm> -- <command...>"
        [ $# -ge 3 ] || usage
        vm="$1"; shift 2
        run "$MULTIPASS" exec "$vm" -- "$@" ;;
    "vm ping")
        # Does the VM manager answer at all? Asked now and then by the server
        # (vmwatch.mjs); bounded, so that a VM manager that hangs is an answer.
        [ $# -eq 0 ] || usage
        run timeout 90 "$MULTIPASS" list --format csv ;;
    "vm revive")
        # The VM manager has not answered for minutes: its daemon restarted.
        # Asked by the server at most once in hours (vmwatch.mjs), never by a page.
        [ $# -eq 0 ] || usage
        run timeout 170 snap restart multipass.multipassd ;;
    "vm states")
        # EVERY MACHINE'S STATE AT ONCE: one question to the VM manager instead of one per
        # machine. It answers one question at a time, and a machine frozen inside makes each
        # question about it wait 10 seconds: asked machine by machine, they queued up and held
        # back every other machine too (21-10). Bounded.
        [ $# -eq 0 ] || usage
        run timeout 120 "$MULTIPASS" list --format json ;;
    "vm info")
        [ $# -eq 1 ] || usage; vm_of "$1"
        run "$MULTIPASS" info "$1" --format json ;;
    "vm start"|"vm stop"|"vm suspend")
        [ $# -eq 1 ] || usage; vm_of "$1"
        run "$MULTIPASS" "$VERB" "$1" ;;
    "vm kill")
        # A stop that does not wait for the system inside: asked only after a
        # clean stop hung or failed (a restart the owner asked for).
        [ $# -eq 1 ] || usage; vm_of "$1"
        run "$MULTIPASS" stop --force "$1" ;;
    "vm set")
        # <vm> memory <megabytes> | <vm> disk <gigabytes> | <vm> cpus <n>. The VM manager
        # takes it only from a stopped machine, and a disk only ever grows:
        # both are its own refusals, passed on as they are.
        vm_of "${1:-}"; [ $# -eq 3 ] || usage
        case "$2" in
            memory) memory_ok "$3"; run "$MULTIPASS" set "local.$1.memory=${3}M" ;;
            # Cores: at most those of the host, which they share.
            cpus)   [[ "$3" =~ ^[0-9]{1,3}$ ]] && [ "$3" -ge 1 ] && [ "$3" -le "$(nproc)" ] || refuse "cpus out of bounds: $3 (the host has $(nproc))"
                    run "$MULTIPASS" set "local.$1.cpus=$3" ;;
            disk)   [[ "$3" =~ ^[0-9]{1,4}$ ]] && [ "$3" -ge 5 ] && [ "$3" -le "$DISK_MAX_GB" ] || refuse "disk out of bounds: $3"
                    # Refused when the host has not the room for it, whatever
                    # the server said (its size unknown: counted from nothing).
                    if [ "$SAY" != "yes" ]; then
                        has="$(size_gb "$("$MULTIPASS" get "local.$1.disk" 2>/dev/null | head -1 | tr -d ' ')")"
                        grow_room "${has:-0}" "$3" "$(store_free)"
                    fi
                    run "$MULTIPASS" set "local.$1.disk=${3}G" ;;
            *) refuse "only memory and disk can be set" ;;
        esac ;;
    "vm size")
        # What the machine really has, as the VM manager says it: one line
        # for its memory, one for its disk. Anything of an unexpected shape
        # is left out rather than passed on.
        [ $# -eq 1 ] || usage; vm_of "$1"
        if [ "$SAY" = "yes" ]; then printf '%s\n' "$MULTIPASS get local.$1.memory" "$MULTIPASS get local.$1.disk" "$MULTIPASS get local.$1.cpus"; exit 0; fi
        for key in memory disk cpus; do
            value="$("$MULTIPASS" get "local.$1.$key" 2>/dev/null | head -1 | tr -d ' ')" || value=""
            if [[ "$value" =~ ^[0-9]{1,12}(\.[0-9]{1,3})?[A-Za-z]{0,3}$ ]]; then printf '%s %s\n' "$key" "$value"; fi
        done
        exit 0 ;;
    "vm delete")
        [ $# -eq 1 ] || usage; vm_of "$1"
        run "$MULTIPASS" delete --purge "$1" ;;
    "vm mount")
        # <vm> <folder|view> <resource> <uid> <gid>
        [ $# -eq 5 ] || usage; vm_of "$1"; is_name "$3" || refuse "not a folder name: $3"; number "$4"; number "$5"
        target="$1:/resources/$3"
        case "$2" in
            folder) folder_of "$3"; source="$MNT/resources/$3" ;;
            view)   kept views; source="$MNT/views/$3"; held "$source"
                    # A read attachment must meet the VIEW, never a bare directory.
                    [ "$SAY" = "yes" ] || mountpoint -q "$source" || refuse "the read-only view of $3 is not in place" ;;
            work)   # The work folder of a conversation goes to ITS machine, and to no other.
                    [ "$1" = "clv-$3" ] || refuse "a work folder belongs to its own conversation"
                    kept work; source="$MNT/work/$3"; held "$source"
                    # Its DISK must be in place: a bare directory there would be the
                    # host's own disk, with no limit.
