#!/bin/bash
# ---------------------------------------------------------------------------
# THE ONLY PRIVILEGED THING THE SERVER MAY DO.
#
# The server runs as an account with no rights. Everything that needs root --
# driving the VM manager, making a read-only view, loading network rules --
# goes through this one program, called with sudo, and the sudoers rule names
# this program and nothing else.
#
# It accepts a FIXED LIST of verbs, in the exact forms the server makes, and
# refuses everything else by name. It is not a general tool and must not
# become one: each verb added here is a thing a compromised server can do.
#
# WHAT IT WILL NOT DO, whatever is asked:
#   - mount anything but a folder of the data directory into a VM. A mount is
#     served as root: any other path would be a way to read the host's files;
#   - touch a VM whose name is not one of ours ("clv-" + a conversation name);
#   - load a network rule that is not, line for line, one of the known shapes.
#
# Every name is checked HERE, even though the server checked it already: this
# is where a string becomes a root command.
#
#   --say-only   print the command instead of running it. For tests: a flag,
#                never an environment variable -- in a privileged program, a
#                variable that changes what runs is the hole being closed.
#   --data DIR   the data directory; honoured ONLY with --say-only. Otherwise
#                it is read from /etc/clavarium/host.conf, which root owns.
#
# Exit codes: the command's own; 64 usage; 78 refused, with the reason.
# ---------------------------------------------------------------------------
set -euo pipefail

MULTIPASS="multipass"
IMAGE="24.04"
DISK="8G"
LAUNCH_SECONDS="900"
BRIDGE="mpqemubr0"
TABLE="clavarium"
VM_ID="1000"
CONF="/etc/clavarium/host.conf"

refuse() { echo "REFUSED: $*" >&2; exit 78; }
usage() { echo "usage: clavarium-host [--say-only [--data DIR]] <vm|view|net> <verb> [arguments]" >&2; exit 64; }

SAY="no"; DATA=""
while [ $# -gt 0 ]; do
    case "$1" in
        --say-only) SAY="yes"; shift ;;
        --data) [ "$SAY" = "yes" ] || refuse "--data is only for --say-only"; DATA="${2:-}"; shift 2 ;;
        *) break ;;
    esac
done
if [ -z "$DATA" ]; then
    [ -r "$CONF" ] || refuse "$CONF is missing: the data directory is not declared"
    DATA="$(sed -n 's/^DATA=//p' "$CONF" | head -1)"
fi
case "$DATA" in /*) : ;; *) refuse "the data directory must be an absolute path" ;; esac
case "$DATA" in *[!A-Za-z0-9/._-]*|*..*) refuse "the data directory has an unexpected character" ;; esac

run() { if [ "$SAY" = "yes" ]; then printf '%s\n' "$*"; else exec "$@"; fi; }

# A conversation or folder name: lower-case letters, digits, hyphens; starts
# with a letter; no trailing hyphen; 32 at most. The same rule as the server.
is_name() { [[ "$1" =~ ^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$ ]]; }
vm_of() { is_name "${1#clv-}" && [ "$1" != "${1#clv-}" ] || refuse "not one of our VMs: ${1:-<empty>}"; }
number() { [[ "$1" =~ ^[0-9]{1,6}$ ]] || refuse "not a number: ${1:-<empty>}"; }

[ $# -ge 2 ] || usage
AREA="$1"; VERB="$2"; shift 2

case "$AREA $VERB" in
    "vm launch")
        [ $# -eq 2 ] || usage; vm_of "$1"; number "$2"
        [ "$2" -ge 512 ] && [ "$2" -le 65536 ] || refuse "memory out of bounds: $2"
        run "$MULTIPASS" launch "$IMAGE" --name "$1" --memory "${2}M" --disk "$DISK" --cpus 1 --timeout "$LAUNCH_SECONDS" ;;
    "vm exec")
        [ $# -ge 1 ] || usage; vm_of "$1"; [ "${2:-}" = "--" ] || refuse "exec takes: <vm> -- <command...>"
        [ $# -ge 3 ] || usage
        vm="$1"; shift 2
        run "$MULTIPASS" exec "$vm" -- "$@" ;;
    "vm info")
        [ $# -eq 1 ] || usage; vm_of "$1"
        run "$MULTIPASS" info "$1" --format json ;;
    "vm start"|"vm stop"|"vm suspend")
        [ $# -eq 1 ] || usage; vm_of "$1"
        run "$MULTIPASS" "$VERB" "$1" ;;
    "vm delete")
        [ $# -eq 1 ] || usage; vm_of "$1"
        run "$MULTIPASS" delete --purge "$1" ;;
    "vm mount")
        # <vm> <folder|view> <resource> <uid> <gid>
        [ $# -eq 5 ] || usage; vm_of "$1"; is_name "$3" || refuse "not a folder name: $3"; number "$4"; number "$5"
        case "$2" in
            folder) source="$DATA/resources/$3" ;;
            view)   source="$DATA/views/$3"
                    # A read attachment must meet the VIEW, never a bare directory.
                    [ "$SAY" = "yes" ] || mountpoint -q "$source" || refuse "the read-only view of $3 is not in place" ;;
            *) refuse "a mount is of a folder or of a view" ;;
        esac
        [ "$SAY" = "yes" ] || [ -d "$source" ] || refuse "no such folder: $3"
        run "$MULTIPASS" mount -u "$4:$VM_ID" -g "$5:$VM_ID" "$source" "$1:/resources/$3" ;;
    "vm umount")
        [ $# -eq 2 ] || usage; vm_of "$1"; is_name "$2" || refuse "not a folder name: $2"
        run "$MULTIPASS" umount "$1:/resources/$2" ;;
    "view make")
        [ $# -eq 1 ] || usage; is_name "$1" || refuse "not a folder name: $1"
        if [ "$SAY" != "yes" ]; then
            [ -d "$DATA/resources/$1" ] || refuse "no such folder: $1"
            mkdir -p "$DATA/views/$1"
            mountpoint -q "$DATA/views/$1" && exit 0
        fi
        run bindfs -r -o allow_other "$DATA/resources/$1" "$DATA/views/$1" ;;
    "view close")
        [ $# -eq 1 ] || usage; is_name "$1" || refuse "not a folder name: $1"
        if [ "$SAY" != "yes" ]; then mountpoint -q "$DATA/views/$1" || exit 0; fi
        run umount "$DATA/views/$1" ;;
    "net taps")
        [ $# -eq 0 ] || usage
        run pgrep -a qemu-system ;;
    "net bridge")
        [ $# -eq 0 ] || usage
        run ip -4 -o addr show "$BRIDGE" ;;
    "net apply")
        # <ruleset>: the whole table, as text. Each line must be one of the
        # shapes the server writes; one unknown line refuses the whole.
        [ $# -eq 1 ] || usage
        tap='"tap-[0-9a-f]{1,12}"'; addr='[0-9]{1,3}(\.[0-9]{1,3}){3}'
        while IFS= read -r line; do
            [[ -z "$line"
            || "$line" =~ ^(delete\ )?table\ bridge\ $TABLE(\ \{)?$
            || "$line" =~ ^\ \ chain\ (between_vms|from_vm)\ \{$
            || "$line" =~ ^\ \ \ \ type\ filter\ hook\ (forward|input)\ priority\ 0\;$
            || "$line" =~ ^\ \ \ \ iifname\ $tap\ (drop|udp\ dport\ 67\ accept|ether\ type\ arp\ accept)$
            || "$line" =~ ^\ \ \ \ iifname\ $tap\ ip\ daddr\ $addr\ (accept|meta\ l4proto\ \{\ tcp,\ udp\ \}\ th\ dport\ 53\ drop)$
            || "$line" =~ ^(\ \ )?\}$ ]] || refuse "a network rule of an unknown shape: $line"
        done <<< "$1"
        run nft "$1" ;;
    *)
        refuse "unknown verb: $AREA $VERB" ;;
esac
