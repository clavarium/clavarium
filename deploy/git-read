#!/usr/bin/sh
# THE ONE READ OF AN AGENT'S REPOSITORY, run by `clavarium-host git read`
# inside its sandbox (installed as /usr/lib/clavarium/git-read, root, 0755).
#
# Fixed text: it takes the folder's name, reads only paths of the repository,
# and never prints them. Its working directory is /resources/<name>, the only
# folder there is.
#
# It refuses a .git that is not a plain directory (a gitfile, a link, a
# commondir could send git to refs elsewhere that the check below never saw),
# refs it cannot read in full (a branch git cannot read would be missing
# without a word, and a missing branch must never look like a deleted one),
# and a shallow or grafted repository (its pack would lack the parents it
# hides, with nothing in the bundle to say so).
#
# Then it writes a version 2 bundle on stdout, BUILT HERE rather than by
# `git bundle create`: the header is the list `git for-each-ref` gives, and
# the pack holds the objects of exactly those ids. `git bundle create`
# resolves every branch a second time by its short name and silently leaves
# out one that moved meanwhile, or whose name is ambiguous (`a` beside `a/b`,
# a branch named `refs/heads/main`): a branch would vanish from a read that
# still succeeds. Here the list is taken once, and checked against the ref
# files on disk: a ref git skips without a word (a symbolic ref pointing
# nowhere or in a loop, a broken file, an invalid name), or a branch made or
# deleted during the read, refuses the read instead of hiding a branch.
#
# Every setting the repository could use to run something is overridden on
# every git command.
#
# Two more ways, after the same checks (the same refusals, the same list):
#   --tips          the header alone: the list of branches, no pack. What
#                   To send needs to see which branches moved, at the cost of
#                   one for-each-ref.
#   --have <id>...  the pack leaves out what those commits reach, for the
#                   server has it already (the remote's history, the last
#                   read): only what is new travels. A commit the repository
#                   does not have is left out of that list, never an error.
#                   The header is the same whole list of branches: a branch
#                   whose commits did not travel is still listed, and the
#                   server checks that it has every object each one needs.
#
# Exit codes: 0; 3 (refs unreadable); 128 only with the 17 bytes of an
# empty bundle (no branches); 66 for anything else, with one line on stderr
# saying what. git's own codes become 66, so that a code systemd uses for
# itself (200-243) can only come from systemd. A git killed by a signal is
# killed again here by the same signal, so that the host still sees a signal.
NAME="$1"
MODE="${2:-}"
case "$MODE" in
  "") [ $# -eq 1 ] || { echo "BAD ARGUMENTS" >&2; exit 66; } ;;
  --tips) [ $# -eq 2 ] || { echo "BAD ARGUMENTS" >&2; exit 66; } ;;
  --have)
    shift 2
    [ $# -ge 1 ] && [ $# -le 256 ] || { echo "BAD ARGUMENTS" >&2; exit 66; }
    for id in "$@"; do
      case "$id" in *[!0-9a-f]*) echo "BAD ARGUMENTS" >&2; exit 66 ;; esac
      [ "${#id}" -eq 40 ] || { echo "BAD ARGUMENTS" >&2; exit 66; }
    done ;;
  *) echo "BAD ARGUMENTS" >&2; exit 66 ;;
esac
[ -d .git ] && [ ! -L .git ] && [ ! -e .git/commondir ] && [ ! -L .git/commondir ] \
  || { echo "NOT A PLAIN .git DIRECTORY" >&2; exit 66; }
for p in .git/refs .git/packed-refs; do
  [ -e "$p" ] || [ -L "$p" ] || continue
  find -L "$p" >/dev/null 2>&1 && [ -z "$(find -L "$p" \( ! -readable -o -type d ! -executable \) -print -quit 2>/dev/null)" ] \
    || { echo "REFS UNREADABLE" >&2; exit 3; }
done
for p in .git/shallow .git/info/grafts; do
  if [ -e "$p" ] || [ -L "$p" ]; then echo "SHALLOW REPOSITORY" >&2; exit 66; fi
done

# git opens THE .git checked above, and nothing else. Left to discover the
# repository, git that finds .git unusable tries the folder itself as a bare
# repository (documented discovery), and would read objects and refs none of
# the checks above looked at -- a read that succeeds where it must refuse.
GIT_DIR=.git
export GIT_DIR
g() {
  /usr/bin/git -c "safe.directory=/resources/$NAME" -c safe.bareRepository=explicit -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -c core.pager=cat -c core.alternateRefsCommand= -c protocol.allow=never -c pack.threads=1 \
    -c pack.windowMemory=256m -c pack.useBitmaps=false "$@"
}
# git failed with code $1: a signal stays a signal, anything else is 66.
failed() {
  if [ "$1" -gt 128 ] && [ "$1" -lt 193 ]; then kill -s "$(($1 - 128))" $$; fi
  echo "$2" >&2
  exit 66
}

format=$(g rev-parse --show-object-format) || failed $? "GIT COULD NOT OPEN THE REPOSITORY"
[ "$format" = "sha1" ] || { echo "NOT SHA-1" >&2; exit 66; }

refs=$(g for-each-ref --format='%(objectname) %(refname)' refs/heads/) || failed $? "GIT COULD NOT LIST THE BRANCHES"
listed=$(printf '%s\n' "$refs" | sed -n 's|^[0-9a-f]\{40\} ||p' | sort -u)
# A file or folder whose name starts with a dot is no ref, for git either: no
# ref name may have a part that starts with one (check-ref-format), so git
# can never make it and never lists it. Such files do appear on their own:
# a folder shared into a machine (sshfs, FUSE) keeps a ref file that was
# replaced while something still had it open as .fuse_hidden<number>, beside
# the new one, until it is closed. Counted, it refused healthy repositories
# as "broken or changing".
on_disk=$( {
  [ -d .git/refs/heads ] && find -L .git/refs/heads -mindepth 1 -name '.*' -prune -o -type f ! -name '*.lock' -printf 'refs/heads/%P\n'
  [ -f .git/packed-refs ] && sed -n 's|^[0-9a-f]\{40\} \(refs/heads/.*\)$|\1|p' .git/packed-refs
} | sort -u)
[ "$listed" = "$on_disk" ] || { echo "BROKEN OR CHANGING REFS" >&2; exit 66; }
[ "$(printf '%s\n' "$refs" | grep -c .)" -le 1000 ] || { echo "MORE THAN 1000 BRANCHES" >&2; exit 66; }

if [ -z "$refs" ]; then
  printf '# v2 git bundle\n\n'
  exit 128
fi
printf '# v2 git bundle\n%s\n\n' "$refs"
[ "$MODE" = "--tips" ] && exit 0
# The commits to leave out: only those this repository has (a name of
# another kind, or none, would stop pack-objects). Should this look fail,
# nothing is left out: the whole pack goes, larger, never wrong.
have=""
if [ "$MODE" = "--have" ]; then
  have=$(printf '%s\n' "$@" | g cat-file --batch-check='%(objectname) %(objecttype)' | sed -n 's/^\([0-9a-f]\{40\}\) commit$/^\1/p')
fi
{ printf '%s\n' "$refs" | cut -c1-40; [ -z "$have" ] || printf '%s\n' "$have"; } | g pack-objects --stdout --revs --delta-base-offset -q
rc=$?
[ "$rc" -eq 0 ] && exit 0
failed "$rc" "GIT COULD NOT PACK THE BRANCHES"
