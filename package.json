{
  "name": "clavarium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A conversation is a VM with a terminal in it. Everything else is a folder.",
  "scripts": {
    "start": "node server/main.mjs",
    "test": "node --test",
    "check": "npm run check:shapes && npm run check:names && npm run check:shell && npm test",
    "check:shapes": "node tools/check-shapes.mjs",
    "check:names": "node tools/check-ai-names.mjs",
    "check:shell": "node tools/check-shell.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  }
}
