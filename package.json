{
  "name": "clavarium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A conversation is a VM with a terminal in it. Everything else is a folder.",
  "scripts": {
    "start": "node server/main.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm run check:hooks && npm run check:shapes && npm run check:names && npm run check:shell && npm test && npm run test:e2e",
    "check:shapes": "node tools/check-shapes.mjs",
    "check:names": "node tools/check-ai-names.mjs",
    "check:shell": "node tools/check-shell.mjs",
    "hooks": "git config core.hooksPath hooks",
    "prepare": "git config core.hooksPath hooks 2>/dev/null || true",
    "check:hooks": "node tools/check-hooks.mjs",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/*.e2e.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
