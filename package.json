{
  "name": "clavarium",
  "version": "0.2.110-next.1",
  "license": "MIT",
  "type": "module",
  "description": "A conversation is a VM with a terminal in it. Everything else is a folder.",
  "homepage": "https://clavarium.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavarium/clavarium.git"
  },
  "bin": {
    "clavarium": "deploy/clavarium.mjs"
  },
  "files": [
    "server/",
    "web/",
    "config/",
    "deploy/",
    "npm-shrinkwrap.json",
    "LICENSE",
    "README.md"
  ],
  "clavarium": {
    "dataFormat": 1
  },
  "scripts": {
    "start": "node server/main.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm run check:hooks && npm run check:shapes && npm run check:names && npm run check:shell && npm test && npm run test:e2e",
    "check:shapes": "node tools/check-shapes.mjs",
    "check:names": "node tools/check-ai-names.mjs",
    "check:shell": "node tools/check-shell.mjs",
    "hooks": "git config core.hooksPath hooks",
    "prepare": "git config core.hooksPath hooks 2>/dev/null || true",
    "check:hooks": "node tools/check-hooks.mjs",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/*.e2e.mjs\"",
    "toolbox": "node deploy/parley-archive.mjs",
    "acceptance": "node acceptance/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clavarium-binder": "0.1.15-next.1",
    "clavarium-docket": "0.1.1",
    "clavarium-parley": "0.17.11-next.1",
    "clavarium-tether": "0.1.0-next.28",
    "mermaid": "11.17.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "6.4.299",
    "prismjs": "1.30.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
